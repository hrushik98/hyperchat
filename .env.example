DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional: override the upstream endpoint for a compatible API or local testing.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: local PostgreSQL password. Set before the first database startup.
# POSTGRES_PASSWORD=choose_a_password
# Optional: credentials for the private, local S3-compatible object store.
# S3_ACCESS_KEY=harper-local
# S3_SECRET_KEY=choose_a_secret
# Optional: use Secure session cookies when serving Harper through HTTPS.
# Leave false for the default http://localhost:4003 setup.
# AUTH_COOKIE_SECURE=true
